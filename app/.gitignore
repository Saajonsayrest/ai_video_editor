node_modules
dist
.DS_Store
.env

# Local whisper.cpp build + models (downloaded on first `npm run captions`)
whisper.cpp

# Local working state (derived per session)
props.json
project.json

# Never commit media: ignore ALL contents of the input/output folders,
# but keep the (empty) folders in git via .gitkeep.
public/input/*
public/output/*
!public/input/.gitkeep
!public/output/.gitkeep
# Keep the music library manifest + docs (but not the audio files themselves).
!public/input/music/
public/input/music/*
!public/input/music/.gitkeep
!public/input/music/README.md
!public/input/music/music-manifest.json
